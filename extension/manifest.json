{
  "manifest_version": 3,
  "name": "FaceGuard",
  "version": "0.5.0",
  "description": "Alerts you when photos matching your face appear where they shouldn't, and flags likely edits.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FaceGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "https://6q03i3h4vi.execute-api.us-east-1.amazonaws.com/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3.us-east-1.amazonaws.com/*"
  ]
}
